# Console server environment. For local use, copy to .env.local.
# Production: use the console host's runtime secrets/settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# These two are public browser build settings, never service-role credentials.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-project-api-key
LIVEKIT_API_SECRET=replace-with-project-api-secret
# Copy the separate SIP hostname from LiveKit; no sip:, https:, or port.
LIVEKIT_SIP_ENDPOINT=your-project.sip.livekit.cloud
# Comma-separated signaling IPs/CIDRs for the inbound Telnyx SIP region.
# Current US example: 192.76.120.10/32,64.16.250.10/32. Verify at sip.telnyx.com.
TELNYX_SIP_ALLOWED_ADDRESSES=

# Generate two different random secrets. Keep the encryption secret stable.
# RUNTIME_SHARED_SECRET must match the worker and contain at least 32 characters.
RUNTIME_SHARED_SECRET=replace-with-a-long-random-shared-secret
PROVIDER_KEY_SECRET=replace-with-a-different-random-encryption-secret

# Optional platform AI keys. Alternatively add keys through Models & Keys in aviroh.
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# CARTESIA_API_KEY=

# Platform-managed US local numbers. Console server only; never VITE_* or worker settings.
# Set enabled=true only after choosing your customer prices and billing arrangement.
MANAGED_TELEPHONY_ENABLED=false
TELNYX_API_KEY=
MANAGED_NUMBER_MONTHLY_USD=
MANAGED_NUMBER_SETUP_USD=
MANAGED_INBOUND_USD_PER_MINUTE=
MANAGED_NUMBER_LIMIT_PER_WORKSPACE=1
# Separate random secret of at least 32 characters for the provisioning cron endpoint.
TELEPHONY_RECONCILE_SECRET=

# Drafting, judgments and reranking. Workspace BYOK takes precedence.
CONTROL_PLANE_AI_PROVIDER=openai
# CONTROL_PLANE_AI_MODEL=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Optional general scheduler authentication (separate from telephony).
# CRON_SECRET=
# CRON_SECRET_PREVIOUS=

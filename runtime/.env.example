# Worker environment. For local use, copy to runtime/.env.local.
# Production: use the worker host's runtime secrets or docker --env-file.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-same-project-api-key
LIVEKIT_API_SECRET=replace-with-same-project-api-secret
AVIROH_CONTROL_PLANE_URL=https://your-console.example.com
RUNTIME_SHARED_SECRET=replace-with-exactly-the-same-secret-as-the-console
# No Telnyx, AI provider, or Supabase credentials belong in the worker.

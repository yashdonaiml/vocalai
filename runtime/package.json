{
  "name": "aviroh-runtime",
  "private": true,
  "type": "module",
  "description": "Stealth Conversation Runtime \u00e2\u20ac\u201d LiveKit Agents worker that executes aviroh runtime bundles.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx src/agent.ts dev",
    "start": "node --env-file-if-exists=.env.local dist/agent.js start",
    "build": "tsc -p .",
    "download-files": "node dist/agent.js download-files"
  },
  "dependencies": {
    "@livekit/agents": "^1.0.0",
    "@livekit/agents-plugin-cartesia": "^1.0.0",
    "@livekit/agents-plugin-deepgram": "^1.0.0",
    "@livekit/agents-plugin-elevenlabs": "^1.0.0",
    "@livekit/agents-plugin-google": "^1.0.0",
    "@livekit/agents-plugin-openai": "^1.0.0",
    "@livekit/agents-plugin-silero": "^1.0.0",
    "zod": "^3.25.0",
    "@livekit/rtc-node": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
